# Gradle
.gradle/
build/
!gradle-wrapper.jar
!gradle-wrapper.properties
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.classpath
.project
.settings/
bin/

# VS Code
.vscode/

# Claude Code
.claude/

# macOS
.DS_Store

# Kotlin
*.kotlin_module

# Logs
*.log

# Temporary files
compile-error*.txt
test-*.txt
*-output*.txt
*-errors.txt
*_errors.txt

# GitBook
_book/
.gitbook/

# Node.js (for Ganache installation)
node_modules/
package-lock.json

# Ruby/Jekyll
# docs/Gemfile.lock is committed so the Pages build resolves the same gems every time.
docs/vendor/
docs/.jekyll-cache/

# Python
__pycache__/
*.py[cod]
*$py.class

# Gradle Node Plugin downloads
build/nodejs/
build/npm/

# Internal documentation (development notes, reviews, implementation details)
# NOTE: must not match Kotlin `internal` source packages — keep these rules doc-scoped.
.internal/
**/.internal/
docs/internal/
/internal/
docs/_site/internal/
docs/_site/

# Local docs HTML preview output
docs_html/

# Rendered documentation PDFs. Markdown under docs/ is the source of truth; a
# committed PDF is a second copy of the same document and drifts from it (the
# MGA guide's PDF ended up showing the pre-rename brand name throughout, plus
# absolute file:/// links to a local working directory). Render on demand
# instead of committing the output.
docs/**/*.pdf

# Superpowers SDD scratch workspace (ledgers, briefs, review packages)
.superpowers/

# Reference wallet CI uses reproducible npm installs.
!reference-wallet/package-lock.json

# Kotlin compiler scratch directory (errors/, sessions/) — never a build input.
.kotlin/

# JVM thread dumps captured while diagnosing a build; not evidence, not source.
*-threads.txt

# Personal multi-root editor workspace; it points at sibling checkouts.
*.code-workspace

# Review evidence: docs/reviews keeps the written review records, but raw build output belongs in
# CI artifacts (see .github/workflows/release-evidence.yml), not in git. Files already committed stay
# tracked as the historical record; these rules stop new ones being added.
docs/reviews/**/*.zip
docs/reviews/**/jacoco*.xml
docs/reviews/**/test-results/
docs/reviews/**/build/
