{
  "expo": {
    "name": "TrustWeave Wallet",
    "slug": "trustweave-reference-wallet",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": [
      "trustweavewallet",
      "openid-credential-offer",
      "openid4vp"
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.trustweave.referencewallet.expo",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "org.trustweave.referencewallet.expo",
      "usesCleartextTraffic": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "openid-credential-offer"
            },
            {
              "scheme": "openid4vp"
            },
            {
              "scheme": "trustweavewallet"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "TrustWeave uses your camera to scan QR codes when adding or sharing credentials."
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "TrustWeave uses NFC to read verification tags when you tap your phone."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "demoBackendBaseUrl": "http://192.168.1.252:3000"
    }
  }
}
