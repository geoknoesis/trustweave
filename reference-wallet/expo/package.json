{
  "name": "trustweave-reference-wallet-expo",
  "version": "0.1.0",
  "private": true,
  "description": "React Native / Expo holder wallet — fourth reference build alongside web, native Android, and native iOS",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "test:vendor": "mocha --forbid-only --reporter dot --timeout 30000 \"vendor/braces/test/*.js\" vendor/node-forge/tests/unit/index.js",
    "test:security": "node vendor/verify.cjs && node --test vendor/security.test.cjs"
  },
  "dependencies": {
    "@noble/ed25519": "2.1.0",
    "@noble/hashes": "2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "bs58": "6.0.0",
    "expo": "~57.0.30",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-get-random-values": "~2.0.0",
    "react-native-nfc-manager": "^3.17.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "braces": "file:vendor/braces",
    "node-forge": "file:vendor/node-forge"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/config-plugins": "~57.0.10",
    "@types/jest": "29.5.14",
    "@types/qrcode": "^1.5.5",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.16",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3",
    "mocha": "12.0.3",
    "bash-path": "2.0.1"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-get-random-values"
      ]
    }
  },
  "overrides": {
    "braces": "$braces",
    "node-forge": "$node-forge"
  }
}
